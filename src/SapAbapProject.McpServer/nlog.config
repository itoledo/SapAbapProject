<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Off">

  <variable name="logDir" value="${environment:variable=SAP_MCP_LOG_DIR:default=${specialfolder:folder=ApplicationData}/SapAbapProject/logs}" />

  <targets async="true">
    <!-- Rolling file: kept across restarts. stdout is RESERVED for MCP JSON-RPC. -->
    <target xsi:type="File"
            name="file"
            fileName="${logDir}/sap-mcp.log"
            archiveFileName="${logDir}/archive/sap-mcp.{#}.log"
            archiveNumbering="Rolling"
            archiveAboveSize="10485760"
            maxArchiveFiles="5"
            keepFileOpen="true"
            layout="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message} ${exception:format=tostring}" />

    <!-- stderr: visible to MCP host for diagnostics. NEVER log to stdout. -->
    <target xsi:type="Console"
            name="stderr"
            error="true"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file,stderr" />
  </rules>
</nlog>
